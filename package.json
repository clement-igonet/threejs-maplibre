{
	"name": "threejs-maplibre",
	"version": "0.1.0",
	"description": "A three.js map engine for OpenStreetMap data, with MapLibre interop",
	"type": "module",
	"main": "./build/threejs-maplibre.module.js",
	"module": "./build/threejs-maplibre.module.js",
	"unpkg": "./build/threejs-maplibre.js",
	"jsdelivr": "./build/threejs-maplibre.js",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./build/threejs-maplibre.module.js",
			"default": "./build/threejs-maplibre.module.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"build",
		"src",
		"types"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build -c vite.lib.config.js && vite build -c vite.lib.config.js --mode standalone",
		"build:site": "vite build",
		"prepack": "npm run build",
		"test": "vitest run",
		"screenshot": "node scripts/screenshot.mjs",
		"bench:vector": "node scripts/bench-vector.mjs",
		"bench": "node scripts/bench.mjs",
		"controls-check": "node scripts/controls-check.mjs",
		"decode-check": "node scripts/decode-check.mjs",
		"budget": "node scripts/budget.mjs",
		"bridge-check": "node scripts/bridge-check.mjs",
		"underlay-check": "node scripts/underlay-check.mjs",
		"types-check": "tsc -p types/tsconfig.json"
	},
	"keywords": [
		"three",
		"threejs",
		"openstreetmap",
		"osm",
		"maplibre",
		"map",
		"tiles",
		"globe"
	],
	"author": "Clement Igonet <clement@igonet.fr>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clement-igonet/threejs-maplibre.git"
	},
	"dependencies": {
		"@mapbox/vector-tile": "^2.0.3",
		"@maplibre/maplibre-gl-style-spec": "^26.4.4",
		"pbf": "^4.0.1"
	},
	"peerDependencies": {
		"three": ">=0.160.0"
	},
	"devDependencies": {
		"3d-tiles-renderer": "^0.5.3",
		"@types/three": "^0.180.0",
		"geojson-vt": "^4.0.2",
		"maplibre-gl": "^6.11.2",
		"osmtogeojson": "^3.0.0-beta.5",
		"polygon-clipping": "^0.15.7",
		"puppeteer": "^24.0.0",
		"three": "^0.180.0",
		"typescript": "^5.6.0",
		"vite": "^7.0.0",
		"vitest": "^3.0.0",
		"vt-pbf": "^3.1.3"
	},
	"types": "./types/index.d.ts"
}
