{
	"name": "threejs-maplibre",
	"version": "0.1.0",
	"description": "A three.js map engine for OpenStreetMap data, with MapLibre interop",
	"type": "module",
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"files": [
		"src"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"test": "vitest run",
		"screenshot": "node scripts/screenshot.mjs",
		"bench": "node scripts/bench.mjs",
		"controls-check": "node scripts/controls-check.mjs",
		"decode-check": "node scripts/decode-check.mjs"
	},
	"keywords": [
		"three",
		"threejs",
		"openstreetmap",
		"osm",
		"maplibre",
		"map",
		"tiles",
		"globe"
	],
	"author": "Clement Igonet <clement@igonet.fr>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clement-igonet/threejs-maplibre.git"
	},
	"dependencies": {
		"@mapbox/vector-tile": "^2.0.3",
		"@maplibre/maplibre-gl-style-spec": "^23.0.0",
		"pbf": "^4.0.1"
	},
	"peerDependencies": {
		"three": ">=0.160.0"
	},
	"devDependencies": {
		"3d-tiles-renderer": "^0.5.3",
		"geojson-vt": "^4.0.2",
		"puppeteer": "^24.0.0",
		"three": "^0.180.0",
		"vite": "^7.0.0",
		"vitest": "^3.0.0",
		"vt-pbf": "^3.1.3"
	}
}
